{
  "include": ["src"],
  "exclude": ["**/__pycache__"],
  "failOnWarnings": false,
  "reportMissingTypeStubs": "warning",
  "reportAny": "none",
  "reportExplicitAny": "none",
  "reportImplicitRelativeImport": "error",
  "reportInvalidCast": "error",
  "reportUnsafeMultipleInheritance": "error",
  "reportPrivateUsage": "none",
}
